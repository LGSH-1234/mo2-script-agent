    {"step_id":"projects-nav","action":"click","locator":{"kind":"role","role":"link","name":"我的项目"},"timeout_ms":10000},
    {"step_id":"projects","action":"wait_for_timeout","duration_ms":800},
    {"step_id":"about-nav","action":"click","locator":{"kind":"role","role":"link","name":"关于我们"},"timeout_ms":10000},
    {"step_id":"about","action":"wait_for_timeout","duration_ms":800}
