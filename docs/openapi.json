  "components": {
    "schemas": {
      "ApplyRevision": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "proposal_id": {
            "type": "string",
            "title": "Proposal Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "proposal_id"
        ],
        "title": "ApplyRevision"
      },
      "Body_reference_api_projects__pid__references_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_reference_api_projects__pid__references_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewProject": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "default": "未命名项目"
          },
          "brief": {
            "type": "string",
            "maxLength": 50000,
            "title": "Brief",
            "default": ""
          },
          "duration": {
            "type": "integer",
            "maximum": 300,
            "minimum": 5,
            "title": "Duration",
            "default": 30
          },
          "ratio": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16",
              "1:1"
            ],
            "title": "Ratio",
            "default": "16:9"
          },
          "style": {
            "type": "string",
            "title": "Style",
            "default": "写实电影感，克制、自然光"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "NewProject"
      },
      "RevisionRequest": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "shot_id": {
            "type": "string",
            "title": "Shot Id"
          },
          "instruction": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Instruction"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "shot_id",
          "instruction"
        ],
        "title": "RevisionRequest"
      },
      "SaveBoard": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "shots": {
            "items": {
              "$ref": "#/components/schemas/Shot"
            },
            "type": "array",
            "maxItems": 60,
            "minItems": 1,
            "title": "Shots"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "shots"
        ],
        "title": "SaveBoard"
      },
      "SaveScript": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "script": {
            "$ref": "#/components/schemas/Script"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "script"
        ],
        "title": "SaveScript"
      },
      "Scene": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "title": "Location"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "title": "Action"
          },
          "dialogue": {
            "type": "string",
            "title": "Dialogue",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "location",
          "action"
        ],
        "title": "Scene"
      },
      "Script": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "synopsis": {
            "type": "string",
            "minLength": 1,
            "title": "Synopsis"
          },
          "scenes": {
            "items": {
              "$ref": "#/components/schemas/Scene"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Scenes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "synopsis",
          "scenes"
        ],
        "title": "Script"
      },
      "Shot": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "default": ""
          },
          "source_scene": {
            "type": "string",
            "minLength": 1,
            "title": "Source Scene"
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title"
          },
          "framing": {
            "type": "string",
            "minLength": 1,
            "title": "Framing"
          },
          "camera": {
            "type": "string",
            "minLength": 1,
            "title": "Camera"
          },
          "duration": {
            "type": "number",
            "maximum": 30,
            "minimum": 1,
            "title": "Duration"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "title": "Action"
          },
          "dialogue": {
            "type": "string",
            "title": "Dialogue",
            "default": ""
          },
          "start_state": {
            "type": "string",
            "minLength": 1,
            "title": "Start State"
          },
          "end_state": {
            "type": "string",
            "minLength": 1,
            "title": "End State"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "default": ""
          },
          "reference_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reference Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_scene",
          "title",
          "framing",
          "camera",
          "duration",
          "action",
          "start_state",
          "end_state"
        ],
        "title": "Shot"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VersionRequest": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          }
