{
  "browser": {"mode":"launch","executable_path":"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome","headless":true},
  "start_url":{"url":"https://app.momostudio.top/"},
  "environment":{"viewport":{"width":1440,"height":900,"device_scale_factor":1},"locale":"zh-CN","timezone":"Asia/Shanghai","color_scheme":"dark","reduced_motion":"reduce","service_workers":"block"},
  "actions":[
    {"step_id":"language","action":"click","locator":{"kind":"role","role":"button","name":"Language"},"timeout_ms":10000},
    {"step_id":"chinese","action":"click","locator":{"kind":"role","role":"menuitem","name":"简体中文"},"timeout_ms":10000},
    {"step_id":"home-zh","action":"wait_for_timeout","duration_ms":1200},
    {"step_id":"about","action":"goto","destination":{"url":"https://app.momostudio.top/about"},"wait_until":"domcontentloaded","timeout_ms":20000},
    {"step_id":"about-zh","action":"wait_for_timeout","duration_ms":1200},
    {"step_id":"pricing","action":"goto","destination":{"url":"https://app.momostudio.top/pricing"},"wait_until":"domcontentloaded","timeout_ms":20000},
    {"step_id":"pricing-zh","action":"wait_for_timeout","duration_ms":1200}
  ],
  "capture":{"after_each_step":["dom","accessibility","screenshot","url"],"at_end":["url"],"events":["page-errors"]}
}
